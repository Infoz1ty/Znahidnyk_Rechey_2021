# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Packaging & build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test, lint & coverage caches
.pytest_cache/
.pylint.d/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & editor files
.vscode/
.idea/
.vs/
*.swp
*.swo
*.tmp
*.bak

# Output artifacts from pipeline runs
results/
output/
*.log

# Large raw camera files (keep converted 8-bit PNGs or external storage)
dataset/raw/

# Generated CSV exports (keep dataset labels and report tables)
*.csv
!dataset/labels.csv
!docs/**/*.csv

# OS generated files
Thumbs.db
.DS_Store
Desktop.ini
